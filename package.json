{
  "name": "multioutils",
  "version": "0.1.0",
  "private": true,
  "description": "Boîte à outils modulaire pour Windows — capture et gestion d'écran",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/shared",
    "desktop-app"
  ],
  "scripts": {
    "dev:app": "npm run dev -w desktop-app",
