{
  "name": "multioutils",
  "version": "0.1.0",
  "private": true,
  "description": "Boîte à outils modulaire pour Windows — capture et gestion d'écran",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/shared",
    "desktop-app",
    "server",
    "streamdeck-plugin"
  ],
  "scripts": {
    "dev:app": "npm run rebuild:electron && npm run dev -w desktop-app",
    "build:app": "npm run build -w desktop-app",
    "rebuild:electron": "electron-rebuild -v 33.4.11 -w better-sqlite3 -m .",
    "dev:server": "npm run dev -w server",
    "build:server": "npm run build -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1"
  },
  "engines": {
    "node": ">=20"
  }
}
