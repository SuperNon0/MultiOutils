# Copie ce fichier en .env et ajuste les valeurs.

# Port d'écoute du serveur (dans le conteneur : toujours 3010 ; ici = port exposé)
APP_PORT=3010

# Dossier hôte où stocker les images + la base SQLite (persistant)
DATA_DIR=./data

# Environnement
NODE_ENV=production

# (Optionnel) Token du tunnel Cloudflare pour l'accès distant.
# À créer dans le dashboard Cloudflare Zero Trust → Access → Tunnels.
# CLOUDFLARED_TOKEN=

# ── Sécurité / accès humain (écran Réglages) ────────────────────────────────
# Ces valeurs ne servent qu'à AMORCER le store au tout premier démarrage : une
# fois stockées, elles se modifient dans le site (page « Réglages »), pas ici.
#
# Vérification du badge Cloudflare Access (JWT). Voir la page Réglages.
# CF_ACCESS_TEAM_DOMAIN=super-nono        # nom d'équipe (sans .cloudflareaccess.com)
# CF_ACCESS_AUD=                          # AUD de l'application Access
# CF_VERIFY_JWT=true                      # true en prod ; false = dev local (en-tête seul)
#
# Mot de passe de SECOURS local (haché au démarrage, jamais stocké en clair).
# ADMIN_PASSWORD=
#
# Secours local activé ? false/0/no/off → entrée UNIQUEMENT via Cloudflare
# (accès direct sans badge = 403). Défaut : activé.
# ALLOW_LOCAL_LOGIN=true
